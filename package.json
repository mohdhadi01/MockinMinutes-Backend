{
  "name": "aiinterviewbot-backend",
  "version": "1.0.0",
  "description": "Express + TypeScript + MongoDB backend for AiInterviewBot",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "lint": "eslint src --ext .ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
